{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permisos de la ventana principal: lo mínimo para la ventana y para guardar el plano y la orden de compra donde el usuario elija.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-title",
    "core:webview:allow-print",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "core:app:allow-version",
    "updater:default",
    "process:allow-restart",
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        { "path": "$DOWNLOAD/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$HOME/**" }
      ]
    }
  ]
}
