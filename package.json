{
  "name": "constructor-de-planos",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "muestra": "esbuild scripts/muestra.ts --bundle --platform=node --format=esm --outfile=.muestra.mjs --log-level=warning && node .muestra.mjs",
    "inspeccionar": "node scripts/inspeccionar-pdf.mjs",
    "tarifas": "node scripts/extraer-tarifas.mjs",
    "herrajes": "node scripts/importar-herrajes.mjs",
    "probar-tarifas": "esbuild scripts/probar-tarifas.ts --bundle --platform=node --format=esm --outfile=.probar.mjs --log-level=warning && node .probar.mjs",
    "tauri": "tauri",
    "app": "tauri dev",
    "exe": "tauri build",
    "probar-modulador": "esbuild scripts/probar-modulador.ts --bundle --platform=node --format=esm --outfile=.modulador.mjs --log-level=warning && node .modulador.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "jspdf": "^4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "pdfjs-dist": "^6.2.108",
    "sharp": "^0.35.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
